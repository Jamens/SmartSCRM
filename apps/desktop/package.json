{
    "name": "@smartscrm/desktop",
    "version": "0.1.0",
    "description": "SmartSCRM desktop client (Electron + React + TypeScript)",
    "main": "./out/main/index.js",
    "author": "SmartSCRM",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck:inject": "tsc --noEmit -p tsconfig.inject.json",
        "typecheck:unit": "tsc --noEmit -p tsconfig.unit.json",
        "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:inject && pnpm run typecheck:unit",
        "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/shared/**/*.test.ts\" \"src/bridge/**/*.test.ts\" \"src/main/services/msgBridge/**/*.test.ts\"",
        "build:inject": "node scripts/build-inject.mjs",
        "watch:inject": "node scripts/build-inject.mjs --watch",
        "build:bridge": "node scripts/build-bridge.mjs",
        "watch:bridge": "node scripts/build-bridge.mjs --watch",
        "start": "electron-vite preview",
        "predev": "pnpm run build:inject && pnpm run build:bridge",
        "dev": "electron-vite dev",
        "build": "pnpm run typecheck && pnpm run build:inject && pnpm run build:bridge && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "pnpm run build && electron-builder --dir",
        "build:win": "pnpm run build && electron-builder --win",
        "build:mac": "electron-vite build && electron-builder --mac",
        "build:linux": "electron-vite build && electron-builder --linux"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@tanstack/react-query": "^5.103.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.3.0",
        "dayjs": "^1.11.23",
        "i18next": "^26.4.2",
        "lucide-react": "^1.47.0",
        "node-machine-id": "^1.1.12",
        "radix-ui": "^1.6.7",
        "react-i18next": "^17.0.14",
        "react-router-dom": "^7.18.4",
        "tailwind-merge": "^3.7.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query-devtools": "^5.103.1",
        "@types/node": "^22.20.3",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "@wppconnect/wa-js": "4.6.0",
        "electron": "^39.2.6",
        "electron-builder": "^26.0.12",
        "electron-vite": "^5.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "prettier": "^3.7.4",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^7.2.6"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild"
        ]
    }
}