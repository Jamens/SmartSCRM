{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["src/shared/**/*.ts", "src/bridge/**/*.ts"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  }
}
