# 本地开发私有配置。**该文件含明文口令，已被 .gitignore 忽略，切勿提交。**
#
# 用法：
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#   然后填入你自己的值。Spring Boot 会自动加载同目录下的 application-local.yml（优先级高于 application.yml）。
#
# 生成一个合规的 JWT 密钥（≥32 字节）：
#   openssl rand -base64 48
#
# 提醒：git 历史里曾提交过明文口令与 JWT 密钥，那份凭据应视为**已泄露**，
# 本地值请用新生成的，不要沿用旧值。

spring:
  datasource:
    password: ""   # 填你的 MySQL 口令

app:
  jwt:
    secret: ""     # 填 openssl rand -base64 48 的输出
